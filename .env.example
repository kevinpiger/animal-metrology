# 四容器部署設定；Compose 從專案根目錄讀取。
# 對外 Web：預設限本機
WEB_BIND_HOST=127.0.0.1
WEB_PORT=8080
# 由 API 在 Docker 內部網路使用，瀏覽器不直接連接
API_PORT=8000
SEG_PORT=8000
POSE_PORT=8000
# Compose 依 port 組成模型服務 URL 並傳給 API。
# 本次固定 CPU 推論；不啟用 CUDA 或 MPS。
MODEL_DEVICE=cpu
# 模型路徑相對於 project/ 根目錄；Compose 以此作為唯讀掛載來源
SEG_MODEL_PATH=./models/animal_seg.pt
POSE_MODEL_PATH=./models/animal_pose.pt
DETECTION_CONF=0.25
EYE_CONF=0.5
MATCH_IOU=0.3
# 僅當次工作暫存，無歷史紀錄；完成或失敗後開始 TTL 計時。
# 容器暫存固定使用 /tmp/metrology（tmpfs）。
RESULT_TTL_SECONDS=1800
MAX_UPLOAD_MB=10
